# Home-GED — variables de la stack
#
# Copier en `.env` (docker compose) ou saisir dans « Environment variables »
# de la stack Portainer. NE JAMAIS COMMITER LE FICHIER `.env` RÉEL.
#
# Générer un secret : openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-64

# --- Réseau --------------------------------------------------------------
# Nom du réseau Docker de Nginx Proxy Manager (docker network ls).
NPM_NETWORK=npm_default
# Sous-réseau de ce réseau, en CIDR :
#   docker network inspect npm_default --format '{{(index .IPAM.Config 0).Subnet}}'
NPM_SUBNET=172.18.0.0/16

# --- Home-GED ------------------------------------------------------------
# Tag des images ghcr.io/dockev03/home-ged et home-ged-backup :
# « main » (dernier commit de main), « sha-xxxxxxx » ou une version (« 1.0.0 »).
HOMEGED_VERSION=main

# --- Paperless -----------------------------------------------------------
# URL publique, sans slash final.
PAPERLESS_URL=https://paperless.example.fr
# Clé de signature des sessions : 64 caractères aléatoires.
PAPERLESS_SECRET_KEY=a-generer
# Mot de passe PostgreSQL (utilisé par Paperless et par la sauvegarde).
POSTGRES_PASSWORD=a-generer

# --- E-mails sortants (rappels d'échéance) — optionnel --------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Sauvegardes (restic vers le NAS en SFTP) -----------------------------
# Adresse publique de la box (IP fixe ou nom DNS) et port redirigé vers le NAS.
SFTP_HOST=203.0.113.10
SFTP_PORT=22022
SFTP_USER=backup-ged
# "nas" est l'alias SSH généré par le conteneur ; le chemin est relatif au chroot.
RESTIC_REPOSITORY=sftp:nas:/restic
# Mot de passe de chiffrement du dépôt restic.
# ⚠️ À CONSERVER HORS DU VPS (gestionnaire de mots de passe) : sans lui, les
# sauvegardes sont illisibles.
RESTIC_PASSWORD=a-generer
# Dossier de l'hôte contenant id_ed25519 et known_hosts.
BACKUP_SSH_DIR=/opt/home-ged/backup-ssh
# Planification (cron, heure de Paris).
BACKUP_CRON=30 2 * * *
# Optionnel : URL "push" Uptime Kuma / healthchecks.io appelée après succès.
BACKUP_HEALTHCHECK_URL=
