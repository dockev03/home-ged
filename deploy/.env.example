# Home-GED — variables de la stack
#
# Le plus simple : `sudo ./install.sh` (ou `--env-seulement` pour Portainer) crée
# `.env` à partir de ce fichier, génère les secrets « a-generer » et renseigne le
# réseau NPM. Il ne reste qu'à compléter les valeurs signalées.
# Portainer : « Load variables from .env file » dans « Environment variables ».
# NE JAMAIS COMMITER LE FICHIER `.env` RÉEL.
#
# Générer un secret à la main : openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-48

# --- Réseau --------------------------------------------------------------
# Nom du réseau Docker de Nginx Proxy Manager (docker network ls).
NPM_NETWORK=npm_default
# Sous-réseau de ce réseau, en CIDR :
#   docker network inspect npm_default --format '{{(index .IPAM.Config 0).Subnet}}'
NPM_SUBNET=172.18.0.0/16

# --- Home-GED ------------------------------------------------------------
# Tag des images ghcr.io/dockev03/home-ged et home-ged-backup :
# une version publiée (« 1.0.0 », figée, recommandé), « 1.0 » (dernier correctif
# de la 1.0) ou « latest » (dernière version stable). Versions : page Releases/tags
# du dépôt GitHub. Mise à jour : changer cette valeur, puis pull et redémarrage.
HOMEGED_VERSION=1.0.0
# Mot de passe du rôle PostgreSQL « homeged » (sessions, liens, clés de chiffrement).
# Rôle et base créés automatiquement par le service init-db, qui réaligne aussi le
# mot de passe à chaque démarrage.
# Lettres et chiffres uniquement : il est inséré dans une chaîne de connexion.
HOMEGED_DB_PASSWORD=a-generer
# Token API du compte de service Paperless en lecture seule, utilisé par la page
# publique des liens de partage (création : docs/deploiement/README.md).
# Vide : les liens ne s'ouvrent pas, le reste de Home-GED fonctionne.
HOMEGED_SHARE_TOKEN=

# --- Paperless -----------------------------------------------------------
# URL publique, sans slash final.
PAPERLESS_URL=https://paperless.example.fr
# Clé de signature des sessions : 64 caractères aléatoires.
PAPERLESS_SECRET_KEY=a-generer
# Mot de passe PostgreSQL (utilisé par Paperless et par la sauvegarde).
POSTGRES_PASSWORD=a-generer
# Premier compte administrateur, créé au démarrage s'il n'existe pas (facultatif).
# Une fois connecté et le 2FA activé, vide PAPERLESS_ADMIN_PASSWORD.
PAPERLESS_ADMIN_USER=
PAPERLESS_ADMIN_PASSWORD=

# --- E-mails sortants (rappels d'échéance) — optionnel --------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Sauvegardes (restic vers le NAS en SFTP) -----------------------------
# Adresse publique de la box (IP fixe ou nom DNS) et port redirigé vers le NAS.
SFTP_HOST=203.0.113.10
SFTP_PORT=22022
SFTP_USER=backup-ged
# "nas" est l'alias SSH généré par le conteneur ; le chemin est relatif au chroot.
RESTIC_REPOSITORY=sftp:nas:/restic
# Mot de passe de chiffrement du dépôt restic.
# ⚠️ À CONSERVER HORS DU VPS (gestionnaire de mots de passe) : sans lui, les
# sauvegardes sont illisibles.
RESTIC_PASSWORD=a-generer
# Dossier de l'hôte contenant id_ed25519 et known_hosts.
BACKUP_SSH_DIR=/opt/home-ged/backup-ssh
# Planification (cron, heure de Paris).
BACKUP_CRON=30 2 * * *
# Optionnel : URL "push" Uptime Kuma / healthchecks.io appelée après succès.
BACKUP_HEALTHCHECK_URL=
