{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Paperless": {
    "BaseUrl": "",
    "ApiVersion": 10,
    "TimeoutSeconds": 30
  },
  "Database": {
    "ConnectionString": "",
    "MigrateOnStartup": true
  },
  "Auth": {
    "IdleTimeoutDays": 30,
    "AbsoluteLifetimeDays": 90,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "Share": {
    "MaxExpirationDays": 30
  },
  "ReverseProxy": {
    "KnownNetworks": []
  }
}
